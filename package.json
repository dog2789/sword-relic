{
  "name": "sword-relic",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:en": "vite --mode en",
    "build": "vite build && vite build --mode en",
    "preview": "vite preview",
    "build:single": "node tools/build-single.mjs",
    "app:pc": "npm run build && npm --prefix desktop start",
    "app:android": "npm run build && cap sync android && cap open android",
    "app:exe": "npm run build && node tools/exe.mjs",
    "app:apk": "npm run build && cap sync android && android\\build-apk.cmd"
  },
  "dependencies": {
    "galmuri": "^2.40.3",
    "phaser": "3.80.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "esbuild": "^0.21.5",
    "vite": "^5.4.0"
  }
}
